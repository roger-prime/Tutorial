digraph SQLite {
graph [bgcolor="white", rankdir=TB, pad=0.2, nodesep=0.65, ranksep=0.7, splines=polyline, outputorder=edgesfirst];
node [shape=plaintext, fontname="Arial"]; edge [fontname="Arial",color="#416477",penwidth=1.6,arrowsize=0.7];
lugar [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#B7C6CE" BGCOLOR="white" CELLPADDING="5"><TR><TD BGCOLOR="#1B3348" ALIGN="LEFT"><FONT COLOR="white"><B>lugar (SQLite)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10"><B>id</B> INTEGER · PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">nombre TEXT · NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">uuid TEXT · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">server_id INTEGER · UNIQUE</FONT></TD></TR></TABLE>>];
categoria [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#B7C6CE" BGCOLOR="white" CELLPADDING="5"><TR><TD BGCOLOR="#1B3348" ALIGN="LEFT"><FONT COLOR="white"><B>categoria (SQLite)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10"><B>id</B> INTEGER · PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">nombre TEXT · NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">uuid TEXT · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">server_id INTEGER · UNIQUE</FONT></TD></TR></TABLE>>];
reporte [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#B7C6CE" BGCOLOR="white" CELLPADDING="5"><TR><TD BGCOLOR="#1B3348" ALIGN="LEFT"><FONT COLOR="white"><B>reporte (SQLite)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10"><B>uuid</B> TEXT · PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">lugar_id INTEGER · FK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">categoria_id INTEGER · FK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">descripcion TEXT · CHECK (10–500)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">fecha_creacion TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">sincronizado INTEGER · 0/1</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">anonimo INTEGER · 0/1</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">autor TEXT · nullable</FONT></TD></TR></TABLE>>];
{rank=same; lugar; categoria;}
lugar -> reporte [label="1 : N",fontsize=11];
categoria -> reporte [label="1 : N",fontsize=11];
}