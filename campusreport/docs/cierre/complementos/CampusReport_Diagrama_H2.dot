digraph H2 {
 graph [bgcolor="white",rankdir=TB,pad=0.2,nodesep=0.55,ranksep=0.8,splines=polyline,outputorder=edgesfirst];
 node [shape=plaintext,fontname="Arial"]; edge [fontname="Arial",color="#416477",penwidth=1.6,arrowsize=0.65];
lugar [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#B7C6CE" BGCOLOR="white" CELLPADDING="5"><TR><TD BGCOLOR="#1B3348" ALIGN="LEFT"><FONT COLOR="white"><B>lugar (H2)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10"><B>id</B> BIGINT · PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">nombre VARCHAR(120)</FONT></TD></TR></TABLE>>];
categoria [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#B7C6CE" BGCOLOR="white" CELLPADDING="5"><TR><TD BGCOLOR="#1B3348" ALIGN="LEFT"><FONT COLOR="white"><B>categoria (H2)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10"><B>id</B> BIGINT · PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">nombre VARCHAR(120)</FONT></TD></TR></TABLE>>];
reporte [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#B7C6CE" BGCOLOR="white" CELLPADDING="5"><TR><TD BGCOLOR="#1B3348" ALIGN="LEFT"><FONT COLOR="white"><B>reporte (H2)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10"><B>uuid</B> VARCHAR(36) · PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">lugar_id BIGINT · FK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">categoria_id BIGINT · FK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">descripcion VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">fecha_creacion VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">anonimo BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">autor VARCHAR(80)</FONT></TD></TR></TABLE>>];
receipt [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#B7C6CE" BGCOLOR="white" CELLPADDING="5"><TR><TD BGCOLOR="#1B3348" ALIGN="LEFT"><FONT COLOR="white"><B>catalog_receipt</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10"><B>tipo + uuid</B> · PK compuesta</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">nombre VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">item_id BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">(sin FK declarada)</FONT></TD></TR></TABLE>>];
lock [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#B7C6CE" BGCOLOR="white" CELLPADDING="5"><TR><TD BGCOLOR="#1B3348" ALIGN="LEFT"><FONT COLOR="white"><B>sync_lock</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10"><B>id</B> BIGINT · PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">fila de bloqueo transaccional</FONT></TD></TR></TABLE>>];
{rank=same; lugar; categoria;}
{rank=same; receipt; lock;}
lugar -> reporte [label="1 : N",fontsize=11];
categoria -> reporte [label="1 : N",fontsize=11];
receipt -> lugar [style=dashed,dir=none,label="asociación lógica",fontsize=9,color="#8E989B",constraint=false];
receipt -> categoria [style=dashed,dir=none,color="#8E989B",constraint=false];
reporte -> receipt [style=invis];
}